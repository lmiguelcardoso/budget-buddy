generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  STOCK
  CRYPTO
  TREASURY
  CASH
  OTHER
}

enum LiabilityType {
  MORTGAGE
  CREDIT_CARD
  STUDENT_LOAN
  OTHER
}

enum Currency {
  USD
  BRL
}

enum AccountStatus {
  PENDING_EMAIL_CONFIRMATION
  ACTIVE
  SUSPENDED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(255)
  passwordHash    String        @map("password_hash")
  name            String?       @db.VarChar(255)
  status          AccountStatus @default(PENDING_EMAIL_CONFIRMATION)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  assets     Asset[]
  liabilities Liability[]
  sessions   Session[]
  snapshots  NetWorthSnapshot[]

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String    @db.VarChar(255)
  type           AssetType
  currency       Currency  @default(USD)
  ticker         String?   @db.VarChar(20)
  quantity       Decimal   @db.Decimal(18, 8)
  manualPrice    Decimal?  @map("manual_price") @db.Decimal(18, 8)
  cachedPrice    Decimal?  @map("cached_price") @db.Decimal(18, 8)
  priceFetchedAt DateTime? @map("price_fetched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("assets")
}

model Liability {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  name      String        @db.VarChar(255)
  type      LiabilityType
  currency  Currency      @default(USD)
  amount    Decimal       @db.Decimal(18, 2)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("liabilities")
}

model NetWorthSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  totalAssetsUsd      Decimal  @map("total_assets_usd") @db.Decimal(18, 2)
  totalLiabilitiesUsd Decimal  @map("total_liabilities_usd") @db.Decimal(18, 2)
  netWorthUsd         Decimal  @map("net_worth_usd") @db.Decimal(18, 2)
  totalAssetsBrl      Decimal  @map("total_assets_brl") @db.Decimal(18, 2)
  totalLiabilitiesBrl Decimal  @map("total_liabilities_brl") @db.Decimal(18, 2)
  netWorthBrl         Decimal  @map("net_worth_brl") @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("net_worth_snapshots")
}
