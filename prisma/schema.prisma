generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  STOCK
  CRYPTO
  TREASURY
  CASH
  OTHER
}

enum LiabilityType {
  MORTGAGE
  CREDIT_CARD
  STUDENT_LOAN
  OTHER
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(255)
  type           AssetType
  ticker         String?   @db.VarChar(20)
  quantity       Decimal   @db.Decimal(18, 8)
  manualPrice    Decimal?  @map("manual_price") @db.Decimal(18, 8)
  cachedPrice    Decimal?  @map("cached_price") @db.Decimal(18, 8)
  priceFetchedAt DateTime? @map("price_fetched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([type])
  @@map("assets")
}

model Liability {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(255)
  type      LiabilityType
  amount    Decimal       @db.Decimal(18, 2)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@map("liabilities")
}

model NetWorthSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  totalAssets      Decimal  @map("total_assets") @db.Decimal(18, 2)
  totalLiabilities Decimal  @map("total_liabilities") @db.Decimal(18, 2)
  netWorth         Decimal  @map("net_worth") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("net_worth_snapshots")
}
