# Local development (Docker)
# DATABASE_URL="postgresql://budgetly:budgetly123@localhost:5432/budgetly"

# Neon (production / Vercel) — copy from Neon dashboard > Connection string
# Format: postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

REDIS_URL="redis://localhost:6379"

# Finance Assistant — OpenAI model to use (key is set per-user in Settings)
OPENAI_MODEL="gpt-4o-mini"

# Encryption key for user OpenAI API keys stored in the database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-string-here"
